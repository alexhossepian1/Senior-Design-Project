# Copy to .env and fill in. NEVER commit .env.
# Generate the password with:  openssl rand -base64 32

DB_NAME=rcpp
DB_USER=rcpp_app
DB_PASSWORD=replace-me-with-a-generated-value

# Domain Caddy will request a certificate for. Use the VM's hostname.
# For a VM with no DNS name, put the IP here and see the README note
# about self-signed certs.
SITE_DOMAIN=rcpartpicker.example.edu
