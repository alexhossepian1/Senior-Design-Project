# LAN deployment: no public DNS name, so no Let's Encrypt. Plain HTTP on
# the private network. Swap this block for {$SITE_DOMAIN} and delete the
# http:// prefix once the VM has a real hostname.
http://192.168.68.15, http://localhost {
    encode gzip
    reverse_proxy app:3000

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
